# PetsLog 云函数环境变量样例（机密，绝不入库）
#
# 这些值在【微信云开发控制台 → 云函数 → parseRecord → 配置 → 环境变量】里设置，
# 运行时由云函数 process.env 读取，不通过本文件加载。本文件仅说明需要哪些变量。
#
# ── 自建 OpenAI 兼容 LLM 网关（真实坐标从私有项目获取）──
GATEWAY_BASE_URL=https://<网关地址>:<端口>/v1
GATEWAY_TOKEN=<在网关为 PetsLog 单独建的 token>
GATEWAY_MODEL=<上游文本模型名，例如 gpt-4o-mini>
# 自签 root CA 的 PEM 文本（含 BEGIN/END CERTIFICATE），用于 https 的 ca 选项信任网关，
# 而非 rejectUnauthorized:false。多行 PEM 在控制台粘贴为带 \n 的单行或直接多行。
GATEWAY_CA=<PEM>
#
# ── 可选 ──
DAILY_PARSE_LIMIT=50
